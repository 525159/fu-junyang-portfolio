---
import { siteConfig } from "../config";
import { withBase } from "../lib/projects";
import Icon from "./Icon.astro";
---
<section class="about-section section container" id="about" aria-labelledby="about-heading">
  <div class="about-title"><p class="eyebrow"><span class="section-number">02 /</span> A LITTLE ABOUT ME</p><h2 id="about-heading">作品背后，<br />是一个好奇的人<span class="heading-dot">。</span></h2><span class="about-signature">{siteConfig.name}<span>一直在路上 ↗</span></span></div>
  <div class="about-copy"><h3>{siteConfig.about.heading}</h3>{siteConfig.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<ul class="interests">{siteConfig.about.interests.map((interest) => <li><span aria-hidden="true">✳</span>{interest}</li>)}</ul>{siteConfig.resume && <a class="text-link" href={withBase(siteConfig.resume)} target="_blank" rel="noopener noreferrer">查看我的简历 <Icon name="download" /></a>}</div>
</section>
